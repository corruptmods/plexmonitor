# ---------------------------------------------------------------- Discord
DISCORD_TOKEN=
CHANNEL_ID=
# Bot admins: comma-separated Discord user IDs. They can run /load /unload
# /reload /cogs and /link /unlink, and they get the DMs asking to approve
# Seerr account links. Leave blank for the bot's owner only (the Discord
# application owner, or its team).
DISCORD_AUTHORIZED_USERS=

# --------------------------------------------------------------- Tautulli
# Preferred source for streams and library counts. Find the API key under
# Tautulli -> Settings -> Web Interface -> API.
# If you leave these blank the bot falls back to talking to Plex directly.
TAUTULLI_URL=http://192.168.1.10:8181
TAUTULLI_API_KEY=
TAUTULLI_VERIFY_SSL=true

# ------------------------------------------------------------------- Plex
# Only used as a fallback when Tautulli is not configured, but harmless to set.
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=

# ---------------------------------------------------------------- SABnzbd
# Optional. Leave blank to hide the downloads panel entirely.
SABNZBD_URL=
SABNZBD_API_KEY=

# ----------------------------------------------------------- Uptime Kuma
# Optional, and this is Uptime Kuma 2.x only.
#
# UPTIME_API_KEY is the recommended auth: create one under
# Settings -> API Keys. The key alone authenticates /metrics.
# Username/password still work if you have never created an API key.
#
# Note: /metrics exposes 24h and 30d uptime but has no 7-day window. The bot
# fills 7d from Kuma's badge endpoint, which only works if the monitor is
# published on a status page. If it is not, the 7-day field is simply hidden.
UPTIME_URL=http://192.168.1.10:3001
UPTIME_MONITOR_ID=
UPTIME_API_KEY=
UPTIME_VERIFY_SSL=true

# Username/password are optional and serve a different purpose from the API
# key: they let the bot read Kuma's transition HISTORY over socket.io, which
# is how it seeds the uptime counter with your real last outage instead of
# starting from zero on first deploy. Kuma keeps transition records for a
# year by default.
#
# Set UPTIME_HISTORY=false to skip this and let the bot track uptime itself.
# If the account has 2FA enabled this cannot work headlessly -- the bot logs a
# warning once and falls back to local tracking.
UPTIME_USERNAME=
UPTIME_PASSWORD=
UPTIME_HISTORY=true

# ----------------------------------------------------------------- Runtime
TZ=Etc/UTC
LOG_LEVEL=INFO

# ---------------------------------------------------------------- UPTIME ---
# UptimeRobot is the recommended uptime source. It probes from outside your
# network, so its figures survive the events a self-hosted monitor cannot
# report on -- this container restarting, the host rebooting, or the
# monitoring stack going down alongside everything it was watching.
#
# Create a read-only API key at https://uptimerobot.com -> Integrations & API.
# A "Main API key" reads every monitor; a monitor-specific key reads one.
# Leave UPTIMEROBOT_MONITOR_ID blank to use the first monitor the key returns.
#
# Setting UPTIMEROBOT_API_KEY takes precedence over the Uptime Kuma settings
# above; leave it blank to keep using Kuma.
UPTIMEROBOT_API_KEY=
UPTIMEROBOT_MONITOR_ID=

# ------------------------------------------------------------------ *ARR ---
# Radarr / Sonarr history is the best source for the "Downloaded" panel.
# They delete SABnzbd's history entry the moment they import, so asking SAB
# what completed returns nothing -- but their own history keeps the record,
# and it says whether the IMPORT succeeded rather than merely that the
# download finished. It also carries the real title: "Dune: Part Two (2024)"
# instead of "Dune.Part.Two.2024.2160p.UHD.BluRay.x265-TERMiNAL".
#
# Find the key in each app under Settings -> General -> Security -> API Key.
# Both are optional; set either, both, or neither.
RADARR_URL=http://radarr:7878
RADARR_API_KEY=
SONARR_URL=http://sonarr:8989
SONARR_API_KEY=

# ----------------------------------------------------------------- SEERR ---
# Seerr or Seerr AI (Overseerr and Jellyseerr share the API but are untested).
# Powers the request panel, /issue and the "Now on Plex" announcements. The bot uses
# the admin API key but acts AS the person asking (X-Api-User), so Seerr
# applies their own permissions and quotas. Find the key in Seerr under
# Settings -> General -> API Key.
#
# Each person links themselves by adding their Discord user ID in Seerr:
# profile -> Settings -> Notifications -> Discord.
#
# SEERR_PUBLIC_URL is only for links in messages; set it when SEERR_URL is a
# LAN address people can't open from their phones.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
SEERR_PUBLIC_URL=
# Channel for the permanent request panel (Request / Ask AI buttons), and the
# channel "Now on Plex" posts go to. Both optional; they override the same
# settings in data/config.json.
REQUEST_PANEL_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=
# Only for a companion watch party bot signed in with this same bot token:
# DM each requester a ▶️ Start watch party button when their title lands.
# Leave false otherwise.
WATCH_PARTY_DMS=false

# -------------------------------------------------------------- ASSISTANT ---
# The AI people talk to privately: Ask AI in the request panel (answer only they
# can see), an @mention in the assistant channel (moved to their DMs), or a
# DM. If your Seerr is Seerr AI (github.com/corruptmods/seerrai), its own AI
# answers by default (no settings needed here). These are the bot's OWN model,
# used with plain Seerr, for people not linked to
# Seerr, or when Seerr's AI is off (assistant.engine in data/config.json).
# Leave AI_API_KEY blank to rely on Seerr AI alone; with plain Seerr and no
# key, the assistant stays off.
#
#   AI_PROVIDER=anthropic  Claude (key from console.anthropic.com)
#   AI_PROVIDER=openai     OpenAI, or any OpenAI-compatible server: set
#                          AI_BASE_URL (e.g. http://ollama:11434/v1 for
#                          Ollama, where AI_API_KEY may stay blank)
#
# AI_MODEL is optional: claude-sonnet-5-5 / gpt-5-mini by default.
# AI_CHANNEL_ID is the channel where @mentions are accepted (or set
# assistant.channel_id in data/config.json). DMs work regardless.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_MAX_TOKENS=1024
AI_CHANNEL_ID=
