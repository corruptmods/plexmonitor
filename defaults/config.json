    "requests": {
        "enabled": true,
        "announce_channel_id": 0,
        "poll_seconds": 120,
        "max_age_hours": 48,
        "discord_links": {},
        "panel_channel_id": 0,
        "watch_party_dms": false
    },
    "_requests_help": [
        "announce_channel_id: channel for 'Now on Plex' posts (0 = off). ANNOUNCE_CHANNEL_ID in .env overrides it.",
        "panel_channel_id: channel for the permanent request panel (Request / Ask AI buttons; 0 = off). REQUEST_PANEL_CHANNEL_ID in .env overrides it. Give it its own channel, not the status or stream cards channel.",
        "watch_party_dms: only for a companion watch party bot signed in with this same bot token: DM each requester a Start watch party button (custom_id reqgo:<user>:<movie|tv>:<tmdb id>:x) when their title lands. Leave false otherwise. WATCH_PARTY_DMS in .env overrides it.",
        "discord_links: {\"<discord user id>\": <seerr user id>} for anyone whose Seerr profile has no Discord ID. Bot admins (DISCORD_AUTHORIZED_USERS, or the owner) can also use /link and /unlink, and approve link requests people send from the Link card."
    ],
    "assistant": {
        "enabled": true,
        "engine": "auto",
        "channel_id": 0,
        "daily_limit": 25,
        "history": 8,
        "delete_mentions": true,
        "dms": true
    },
    "_assistant_help": [
        "Conversations are private: Ask AI in the request panel answers only the asker (with a Reply button), and an @mention in channel_id moves the chat to the person's DMs.",
        "engine: 'seerr' = Seerr's own AI (asked as the person: their watch history, Seerr's model and daily limit); 'own' = the bot's AI_PROVIDER model; 'auto' = Seerr's AI for linked people it's on for, the bot's model otherwise.",
        "/recap is Seerr's Catch Me Up: it uses Seerr's AI, so it is off when engine is 'own'.",
        "channel_id: where @mentions are accepted (0 = any channel). DMs always work while dms is true.",
        "delete_mentions: remove the @mention from the channel so the question isn't public (needs Manage Messages there).",
        "daily_limit: questions per person per day on the bot's own model (0 = unlimited); Seerr's AI keeps its own limit. history: remembered exchanges per conversation. Provider and key live in .env."
    ]
}
